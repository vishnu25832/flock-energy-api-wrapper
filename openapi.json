{
  "openapi": "3.0.0",
  "info": {
    "title": "Flock Energy API",
    "version": "1.0.0",
    "description": "REST API wrapper around the Urja Operations Portal used for retrieving meter, energy, geographic, and transformer data."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Meters",
      "description": "Meter discovery and meter-related operations"
    },
    {
      "name": "Transformers",
      "description": "Distribution transformer operations"
    }
  ],
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Meter not found"
          }
        }
      },
      "GeoLocation": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "string",
            "example": "26.938961002479868"
          },
          "longitude": {
            "type": "string",
            "example": "75.83095696146852"
          }
        }
      },
      "EnergyReading": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "example": "27/06/2026 12:00"
          },
          "kwh": {
            "type": "string",
            "example": "123.45"
          },
          "kvah": {
            "type": "string",
            "example": "130.12"
          },
          "voltR": {
            "type": "string",
            "example": "231.50"
          }
        }
      }
    }
  },
  "paths": {
    "/api/meters": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get all meters",
        "description": "Returns a paginated list of meters, optionally filtered by a search query.",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "description": "Page number; must be a positive integer.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "description": "Optional meter search query.",
            "schema": {
              "type": "string",
              "default": ""
            },
            "example": "J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved meters."
          },
          "400": {
            "description": "Invalid page parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/meters/{meterId}": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get a meter by ID",
        "description": "Returns meter information together with geographic location and energy readings.",
        "parameters": [
          {
            "in": "path",
            "name": "meterId",
            "required": true,
            "description": "Unique meter identifier.",
            "schema": {
              "type": "string"
            },
            "example": "J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the meter and related data."
          },
          "404": {
            "description": "Meter not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/meters/{meterId}/energy": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get meter energy readings",
        "description": "Returns energy readings for the specified meter.",
        "parameters": [
          {
            "in": "path",
            "name": "meterId",
            "required": true,
            "description": "Unique meter identifier.",
            "schema": {
              "type": "string"
            },
            "example": "J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved energy readings."
          },
          "404": {
            "description": "Meter or energy resource not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/meters/{meterId}/geo": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get meter geographic location",
        "description": "Returns the latitude and longitude associated with the specified meter.",
        "parameters": [
          {
            "in": "path",
            "name": "meterId",
            "required": true,
            "description": "Unique meter identifier.",
            "schema": {
              "type": "string"
            },
            "example": "J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the meter location.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/GeoLocation"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Meter or geographic resource not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/transformers": {
      "get": {
        "tags": [
          "Transformers"
        ],
        "summary": "Get distribution transformers",
        "description": "Returns a paginated list of distribution transformers from the Urja Operations Portal.",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "description": "Page number. Must be a positive integer.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved distribution transformers."
          },
          "400": {
            "description": "Invalid page parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
